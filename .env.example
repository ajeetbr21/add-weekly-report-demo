# Copy to .env and adjust:  cp .env.example .env
# Never commit .env. No real credentials belong in this file.
# Generate secrets with:  python3 -c "import secrets; print(secrets.token_urlsafe(32))"

# ---- application ------------------------------------------------------------------------------
APP_ENV=local
LOG_LEVEL=INFO
LOG_JSON=true
APPLICATION_SECRET=change-me
# Token required on /api/* (Authorization: Bearer <token> or X-API-Key). The web UI proxy injects it
# server-side, the Telegram bot sends it. Strongly recommended even locally.
ATLAS_API_TOKEN=change-me-local-api-token
DEFAULT_PROJECT_SLUG=default
# Origins allowed to call the API from a browser (CORS + CSRF origin check)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173

# ---- database (compose builds DATABASE_URL from these) ------------------------------------------
POSTGRES_USER=atlas
POSTGRES_PASSWORD=atlas-local-password
POSTGRES_DB=atlas
# Only used when running the backend outside compose (compose overrides it):
DATABASE_URL=postgresql+asyncpg://atlas:atlas-local-password@localhost:5432/atlas

# ---- OmniRoute model gateway (OpenAI-compatible) -----------------------------------------------
# 1) open http://localhost:20128, connect at least one provider and create an API key
# 2) set OMNIROUTE_ENABLED=true, paste the key, and pick model names / combos per tier
# Until then agents run in the clearly labelled offline mode (no LLM).
OMNIROUTE_ENABLED=false
OMNIROUTE_BASE_URL=http://omniroute:20128/v1
OMNIROUTE_API_KEY=
MODEL_DEFAULT=auto
MODEL_FAST=
MODEL_REASONING=
MODEL_CODING=
# Embeddings via OmniRoute (optional). Empty = built-in local-hash-v1 lexical embeddings.
EMBEDDING_MODEL=
EMBEDDING_DIMENSIONS=1536
LLM_OFFLINE_FALLBACK=true
# RAM for the OmniRoute container (MB)
OMNIROUTE_MEMORY_MB=1024

# ---- Letta (session state runtime) -------------------------------------------------------------
LETTA_ENABLED=true
LETTA_BASE_URL=http://letta:8283
LETTA_API_KEY=

# ---- tools: local MCP server + Composio MCP --------------------------------------------------
LOCAL_MCP_ENABLED=true
LOCAL_MCP_URL=http://mcp-local:8765/mcp
# optional shared secret between the agents and the local MCP server
LOCAL_MCP_TOKEN=
# Composio (GitHub / AWS / Google): create an MCP session or server for the toolkits you want, then set
# the Streamable HTTP URL and either the project API key or the full header JSON the SDK exports
# (session.mcp.headers), e.g. COMPOSIO_MCP_HEADERS={"x-api-key":"...","x-project-id":"..."}
COMPOSIO_ENABLED=false
COMPOSIO_MCP_URL=
COMPOSIO_API_KEY=
COMPOSIO_MCP_HEADERS=
COMPOSIO_USER_ID=

# ---- Telegram --------------------------------------------------------------------------------
# Token from @BotFather. Restrict the bot to your own chat id(s), comma separated.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_CHAT_IDS=

# ---- webhooks (HMAC-SHA256 secrets; empty = API token required instead) ---------------------------
GITHUB_WEBHOOK_SECRET=
CUSTOM_WEBHOOK_SECRET=

# ---- worker / scheduler / memory tuning ------------------------------------------------------------
WORKER_CONCURRENCY=2
TASK_LEASE_SECONDS=120
TASK_MAX_RETRIES=2
AGENT_MAX_ITERATIONS=6
SCHEDULER_INTERVAL_SECONDS=15
MEMORY_TOP_K=6
LEARNING_AUTO_APPROVE_THRESHOLD=0.85
