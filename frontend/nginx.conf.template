# Serves the dashboard and proxies API calls to the local FastAPI backend.
# The API token is injected server-side so it never has to be typed into the browser. That is only
# safe because (1) the port is bound to 127.0.0.1 (docker-compose.yml), (2) only localhost host names are
# served (DNS-rebinding protection), (3) the API rejects cross-origin state-changing requests (CSRF) and
# (4) webhooks are not reachable through this proxy.

# any other Host header (e.g. a rebinding domain pointing at 127.0.0.1) is refused
server {
    listen 80 default_server;
    return 403;
}

server {
    listen 80;
    # "frontend" is the compose-internal service name (used by in-network checks)
    server_name localhost 127.0.0.1 frontend;
    root /usr/share/nginx/html;
    client_max_body_size 2m;

    # re-resolve the API container on every request (its IP changes when it is recreated/restarted);
    # NGINX_LOCAL_RESOLVERS is filled in by the nginx image entrypoint from /etc/resolv.conf
    resolver ${NGINX_LOCAL_RESOLVERS} valid=10s ipv6=off;
    set $atlas_api ${ATLAS_API_UPSTREAM};

    # webhooks must authenticate themselves (signature/token) directly against the API on :8000;
    # never let them ride on the token this proxy injects
    location ^~ /api/webhooks/ {
        return 403;
    }

    location ~ ^/(api|health|ready|docs|openapi.json) {
        proxy_pass $atlas_api;
        proxy_set_header Host $host;
        proxy_set_header X-API-Key "${ATLAS_API_TOKEN}";
        proxy_read_timeout 120s;
    }

    location / {
        try_files $uri /index.html;
    }
}
